# ==============================================================================
# STUDYMATE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local or expose service-role keys to the browser.
# ==============================================================================

# 1. Supabase PostgreSQL & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=study-materials

# 2. Google Gemini API (Server-side only)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# 3. Session Signing Secret (Generate a random 64-character hex string)
SESSION_SECRET=replace-with-at-least-32-character-random-cryptographic-secret

# 4. Protected Admin & Exclusive SuperAdmin Credentials
ADMIN_ID=ADMIN-STUDYMATE
ADMIN_PIN=replace-with-6-to-8-digit-admin-pin
ADMIN_EMAILS=ratawajahnvi@gmail.com
SUPERADMIN_EMAILS=amrendrayadav03321@gmail.com

# 5. Optional Outbound Email Provider for Block Notifications
RESEND_API_KEY=
SMTP_FROM=StudyMate AI Security <security@studymate.ai>
EMAIL_WEBHOOK_URL=
